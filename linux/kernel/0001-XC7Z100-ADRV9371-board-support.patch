diff --git a/arch/arm/boot/dts/zynq-zc706.dtsi b/arch/arm/boot/dts/zynq-zc706.dtsi
--- a/arch/arm/boot/dts/zynq-zc706.dtsi
+++ b/arch/arm/boot/dts/zynq-zc706.dtsi
@@ -3,7 +3,7 @@
 #include <dt-bindings/interrupt-controller/irq.h>
 
 / {
-	model = "Xilinx Zynq ZC706";
+	model = "OpenSourceSDRLab XC7Z100-ADRV9371";
 	memory {
 		device_type = "memory";
 		reg = <0x00000000 0x40000000>;
@@ -11,9 +11,9 @@
 
 	chosen {
 		bootargs = "console=ttyPS0,115200 root=/dev/mmcblk0p2 rw earlyprintk rootfstype=ext4 rootwait";
-		stdout-path = "/amba@0/uart@E0001000";
-	};
-
+		stdout-path = "serial0:115200n8";
+   };
+/*
 	leds {
 		compatible = "gpio-leds";
 		ds8 {
@@ -61,22 +61,26 @@
 			gpios = <&gpio0 59 0>;
 		};
 	};
+	*/
 };
 
 &gem0 {
-	phy-handle = <&phy0>;
+	status = "okay";
 	phy-mode = "rgmii-id";
+	phy-handle = <&phy0>;
 
-	phy0: phy@7 {
-		device_type = "ethernet-phy";
-		reg = <0x7>;
+	phy0: phy@0 { /* Marvell 88e1512 */
+		reg = <0>;
+		compatible = "ethernet-phy-ieee802.3-c22";
 	};
 };
 
+
 &usb0 {
-	xlnx,phy-reset-gpio = <&gpio0 7 0>;
+	xlnx,phy-reset-gpio = <&gpio0 46 0>;
 };
 
+/*
 &qspi {
 	status = "okay";
 	is-dual = <1>;
@@ -111,3 +115,42 @@
 		};
 	};
 };
+*/
+
+&qspi {
+	status = "okay";
+	is-dual = <1>;
+	num-cs = <1>;
+	primary_flash: ps7-qspi@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <4>;
+		compatible = "winbond,w25q256";  /* correct compatible string */
+		reg = <0x0>;
+		spi-max-frequency = <50000000>;  /* must not exceed the flash maximum (W25Q256: typically 104 MHz); adjust as needed */
+
+		partition@0 {
+			label = "boot";
+			reg = <0x00000000 0x00500000>;  /* 5MB */
+		};
+		partition@500000 {
+			label = "bootenv";
+			reg = <0x00500000 0x00020000>;  /* 128KB */
+		};
+		partition@520000 {
+			label = "config";
+			reg = <0x00520000 0x00020000>;  /* 128KB */
+		};
+		partition@540000 {
+			label = "image";
+			reg = <0x00540000 0x00a80000>;  /* 10.5MB */
+		};
+		partition@fc0000 {
+			label = "spare";  /* remaining space: 32 MB - 15.75 MB = 16.25 MB */
+			reg = <0x00fc0000 0x01040000>;  /* start 0xfc0000, size 0x1040000 (up to the end of 32 MB) */
+		};
+	};
+};
+
+
diff --git a/arch/arm/boot/dts/zynq.dtsi b/arch/arm/boot/dts/zynq.dtsi
--- a/arch/arm/boot/dts/zynq.dtsi

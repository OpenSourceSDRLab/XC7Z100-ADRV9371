#!/bin/sh
### BEGIN INIT INFO
# Provides:          adrv9371-heartbeat
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: ADRV9371 initialization heartbeat
### END INIT INFO

daemon=/usr/sbin/adrv9371-heartbeat
pidfile=/run/adrv9371-heartbeat.pid

read_pid() {
    pid=$(cat "$pidfile" 2>/dev/null) || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ]
}

is_our_process() {
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' '\n' < "/proc/$pid/cmdline" | grep -Fx "$daemon" >/dev/null
}

case "$1" in
    start)
        if read_pid && kill -0 "$pid" 2>/dev/null; then
            if is_our_process; then
                exit 0
            fi
            echo "Heartbeat PID file refers to another process" >&2
            exit 1
        fi
        [ -x "$daemon" ] || exit 1
        "$daemon" >/dev/null 2>&1 &
        printf '%s\n' "$!" > "$pidfile"
        ;;
    stop)
        read_pid || exit 0
        if kill -0 "$pid" 2>/dev/null; then
            is_our_process || exit 1
            kill -TERM "$pid" || exit 1
        fi
        for attempt in 1 2 3 4 5; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done
        if kill -0 "$pid" 2>/dev/null; then
            echo "ADRV9371 heartbeat did not stop" >&2
            exit 1
        fi
        rm -f "$pidfile"
        ;;
    restart|force-reload)
        "$0" stop || exit $?
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload}" >&2
        exit 1
        ;;
esac

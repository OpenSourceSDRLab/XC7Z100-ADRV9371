#!/bin/sh
# Blink after the ADRV9371 driver has initialized the radio.
sysfs=${ADRV9371_HEARTBEAT_SYSFS:-/sys}
led="$sysfs/class/leds/adrv9371:heartbeat"
mode=unknown

read_attr() {
    cat "$1" 2>/dev/null
}

radio_ready() {
    for dev in "$sysfs"/bus/iio/devices/iio:device*; do
        case "$(read_attr "$dev/name")" in
            adrv9371-phy|ad9371-phy) ;;
            *) continue ;;
        esac
        [ "$(read_attr "$dev/ensm_mode")" = radio_on ] || return 1
        return 0
    done
    return 1
}

led_off() {
    [ -w "$led/trigger" ] && [ -w "$led/brightness" ] || return 1
    printf 'none\n' > "$led/trigger" || return 1
    printf '0\n' > "$led/brightness"
}

led_blink() {
    [ -w "$led/trigger" ] || return 1
    printf 'timer\n' > "$led/trigger" || return 1
    printf '500\n' > "$led/delay_on" || return 1
    printf '500\n' > "$led/delay_off"
}

trap 'exit 0' TERM INT
trap 'led_off >/dev/null 2>&1 || :' EXIT

while :; do
    if radio_ready; then
        if [ "$mode" != ready ]; then
            if led_blink; then
                mode=ready
                logger -t adrv9371-heartbeat 'ADRV9371 initialized; LED heartbeat enabled'
            else
                led_off >/dev/null 2>&1 || :
            fi
        fi
    elif [ "$mode" != waiting ]; then
        if led_off; then
            mode=waiting
            logger -t adrv9371-heartbeat 'Waiting for ADRV9371 initialization; LED off'
        fi
    fi
    sleep 1
done
